* text=auto

# Shell scripts keep LF
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# C/C++ and build files
*.c text
*.cc text
*.cpp text
*.h text
*.hpp text
*.cmake text
CMakeLists.txt text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.lib binary
*.pdb binary
